\code{"sinusoidal"}Default depends on \code{scope}.}

\item{scope}{One of \code{"world"}, \code{"usa"}, \code{"europe"}, \code{"asia"}, \code{"africa"},
\code{"north america"}, or \code{"south america"}Default is \code{"world"} unless
\code{projection} is set to \code{"albers usa"}, which forces \code{"usa"}.}

\item{center}{Dict keys are \code{"lat"} and \code{"lon"} Sets the center point of
the map.}

\item{fitbounds}{One of \code{FALSE}, \code{locations} or \code{geojson}.}

\item{basemap_visible}{Force the basemap visibility.}

\item{zoom}{Between 0 and 20. Sets initial map zoom level. Higher values
are more zoomed-in. If not provided, the map will select its own zoom
level.}

\item{map_style}{Identifier of base map style. Allowed values are
\code{"basic"}, \code{"carto-darkmatter"}, \code{"carto-darkmatter-nolabels"},
\code{"carto-positron"}, \code{"carto-positron-nolabels"}, \code{"carto-voyager"},
\code{"carto-voyager-nolabels"}, \code{"dark"}, \code{"light"}, \code{"open-street-map"},
\code{"outdoors"}, \code{"satellite"}, \code{"satellite-streets"}, \code{"streets"},
\code{"white-bg"}.}

\item{radius}{Sets the radius of influence of each point.}

\item{dimensions}{Column names in \code{data_frame} (a character vector or a
formula such as \code{~c(a, b)}), or a list of column names, formulas and
vectors. Values from these columns are used for
multidimensional visualization.}

\item{dimensions_max_cardinality}{When \code{dimensions} is \code{NULL} and
\code{data_frame} is provided, columns with more than this number of unique
values are excluded from the output. Not used when \code{dimensions} is passed.}

\item{names}{A column name in \code{data_frame}, a vector of values, a
one-sided formula evaluated in \code{data_frame} (e.g. \code{~ log(pop)}),
\code{\link[=px_constant]{px_constant()}} or \code{\link[=px_range]{px_range()}}. Values from this column or vector are
used as labels for sectors.}

\item{values}{A column name in \code{data_frame}, a vector of values, a
one-sided formula evaluated in \code{data_frame} (e.g. \code{~ log(pop)}),
\code{\link[=px_constant]{px_constant()}} or \code{\link[=px_range]{px_range()}}. Values from this column or vector are
used to set values associated to sectors.}

\item{hole}{Number between 0 and 1: the fraction of the radius cut out of
the pie to make a donut chart.}

\item{parents}{A column name in \code{data_frame}, a vector of values, a
one-sided formula evaluated in \code{data_frame} (e.g. \code{~ log(pop)}),
\code{\link[=px_constant]{px_constant()}} or \code{\link[=px_range]{px_range()}}. Values from this column or vector are
used as parents in sunburst and treemap charts.}

\item{path}{Column names in \code{data_frame} (a character vector or a formula
such as \code{~c(a, b)}), or a list of column names, formulas and vectors. The columns define the hierarchy of sectors,
from root to leaves. Cannot be combined with \code{ids} or \code{parents}.}

\item{ids}{A column name in \code{data_frame}, a vector of values, a one-sided
formula evaluated in \code{data_frame} (e.g. \code{~ log(pop)}), \code{\link[=px_constant]{px_constant()}} or
\code{\link[=px_range]{px_range()}}. Values from this column or vector are used to set ids of
sectors}

\item{branchvalues}{"total" or "remainder" Determines how the items in
\code{values} are summed. Whenset to "total", items in \code{values} are taken to be
valueof all its descendants. When set to "remainder", itemsin \code{values}
corresponding to the root and the branches:sectors are taken to be the
extra part not part of thesum of the values at their leaves.}

\item{maxdepth}{Positive integer Sets the number of rendered sectors from
any given \code{level}. Set \code{maxdepth} to -1 to render all thelevels in the
hierarchy.}
}
\description{
Arguments shared by the Plotly Express functions; see \code{\link[=px_scatter]{px_scatter()}} and the other
functions in the family.
}
\keyword{internal}
